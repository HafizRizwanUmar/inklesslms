# ─────────────────────────────────────────────────────────────────
# INKLESS CLIENT — ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit real keys to source control.

# RevenueCat Web Billing Public API Key
# ✅ Your test key is pre-configured in revenuecat.js
# For production: get from app.revenuecat.com → API Keys → Web Billing
VITE_REVENUECAT_API_KEY=test_PbNqiaqJqKnVxuFbVijcmyqqzxP

# RevenueCat Customer Center URL (optional)
# Get from: app.revenuecat.com → Customer Center → Portal URL
# Allows subscribers to self-manage (cancel, change plan, view history)
VITE_REVENUECAT_CUSTOMER_CENTER_URL=
